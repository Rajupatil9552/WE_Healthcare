# Contact form email delivery (SMTP). Copy to .env.local and fill in.
# Never commit real credentials.
#
# Use the SMTP settings of whichever provider hosts sales@wehealthcare.us:
#   Google Workspace:  SMTP_HOST=smtp.gmail.com      SMTP_PORT=465 (app password required)
#   Microsoft 365:     SMTP_HOST=smtp.office365.com  SMTP_PORT=587
#   Zoho Mail:         SMTP_HOST=smtp.zoho.com       SMTP_PORT=465
# Or a transactional service (SendGrid, Amazon SES, Postmark, Resend SMTP).

SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); leave empty to infer from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Where submissions are delivered.
CONTACT_TO_EMAIL=sales@wehealthcare.us
# Sender address. Must be an address the SMTP account is allowed to send as
# (usually SMTP_USER, or a verified domain address). Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=
